CREATE OR REPLACE TASK sales_task
    WAREHOUSE = COMPUTE_WH,
    SCHEDULE = 'USING CRON 0 0 * * * UTC' //Everyday at 12:00 AM 
    WHEN SYSTEM$STREAM_HAS_DATA('sales_stream')
    AS
    MERGE INTO sales_final_table F
    USING (
        SELECT STRE.*, ST.LOCATION, ST.EMPLOYEES  FROM sales_stream STRE
        JOIN store_table ST
        ON STRE.store_id = ST.STORE_ID
         )S
    ON F.id = S.id
    WHEN MATCHED
        AND METADATA$ISUPDATE = FALSE
        AND METADATA$ACTION = 'DELETE'
        then delete
    WHEN MATCHED
        AND METADATA$ISUPDATE = TRUE
        AND METADATA$ACTION = 'UPDATE'
        then update 
        SET F.product = S.product,
            F.price = S.price,
            F.amount = S.amount,
            F.store_id = S.store_id

    WHEN NOT MATCHED
        AND METADATA$ISUPDATE = FALSE
        AND METADATA$ACTION = 'INSERT'
        then INSERT
        (id, product, price, amount, store_id, location, employees)
         values
        (s.id, s.product, s.price, s.amount,s.store_id, s.location, s.employees);
        
        
SHOW TASKS;    


